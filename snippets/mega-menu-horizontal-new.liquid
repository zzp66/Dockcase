<style>
  .mega-menu-horizontal-new {
    width: 100%;
    z-index: 99;
  }
  .mega-menu-horizontal-new-content {
    width: 100%;
    display: grid;
    grid-template-columns: repeat(6, 1fr);
    gap: 15px;
  }
  .horizontal-product-card img {
    transition: all 0.3s ease-in-out;
  }
  .horizontal-product-card:hover .horizontal-product-card img {
    transform: scale(1.5);
  }
  .horizontal-product-card {
    width: 100%;
    height: 100%;
    background-color: #f5f6f7;
    display: flex;
    border-radius: 16px;
    overflow: hidden;
  }
  a.view-all-card {
    width: 100%;
    color: #000;
    display: flex;
    justify-content: center;
    align-items: center;
    font-size: 20px;
    font-weight: 600;
    transition: all 0.3s ease-in;
  }
  a.view-all-card:hover {
    text-decoration: underline;
    text-underline-offset: 8px;
    color: #00aad1;
  }
  .horizontal-product-card .product-title {
    color: #000;
    font-size: 14px;
    line-height: 18px;
    padding: 10px 20px;
  }
</style>
<div class="mega-menu-horizontal-new mega-menu justify-center">
  <div class="mega-menu-horizontal-new-content">
    {% assign collection = mega_menu_block.settings.collection %}
    {% if collection != blank %}
      {% for product in collection.products limit: 5 %}
        <div class="horizontal-product-card">
          <a href="{{ product.url }}">
            <img src="{{ product.featured_image | image_url: master }}" alt="{{ product.title }}">
            <div class="product-title">{{ product.title }}</div>
          </a>
        </div>
      {% endfor %}
      <div class="horizontal-product-card">
        <a class="view-all-card" href="{{ collection.url }}">View All</a>
      </div>
    {% endif %}
  </div>
</div>

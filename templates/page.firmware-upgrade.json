    "format_ssd_guide_2_fpk6ac": {
      "type": "format-ssd-guide-2",
      "blocks": {
        "heading_8km7kc": {
          "type": "heading",
          "settings": {
            "heading": "Firmware Update Notice"
          }
        },
        "rich_text_7zQ9Vi": {
          "type": "rich_text",
          "settings": {
            "rich_text": "<p>Dear Valued Customer,<br/><br/>Thank you for choosing DOCKCASE. Before proceeding with a firmware update, please carefully read the following important notes:<br/><br/><strong>1. Firmware Stability & Upgrade Recommendation</strong><br/><br/>The firmware pre-installed on your product has been fully tested and verified to ensure optimal stability and broad compatibility. If you are not experiencing any specific functional or compatibility issues, we do NOT recommend updating the firmware, as unnecessary updates may cause unexpected risks.<br/><br/>When important feature improvements or necessary updates, DOCKCASE will release official notifications as soon as they become available. For the latest information, please contact our support team at support@dockcase.com.</p>"
          }
        },
        "rich_text_H7ef46": {
          "type": "rich_text",
          "settings": {
            "rich_text": "<p><strong>2. When a Firmware Update Is Required</strong><br/><br/>If you are experiencing functional issues or compatibility problems, our support team may recommend a firmware update after reviewing your device information.<br/><br/>Before we can provide any firmware file, please send the following information to our support team:</p><p><br/>▪️Order number<br/>▪️Dockcase “About Me” page: </p><p>Press and hold the side D-Key until the “About Me” screen appears. Take a photo of this page and send it to us.<br/><br/>Additional information (for diagnosis):<br/><br/>▪️Host device model (computer / phone / tablet)<br/>▪️Operating system and version<br/>▪️SSD or storage device model<br/>▪️Detailed description of the issue and usage scenario<br/>▪️Photos or videos showing the problem (if possible)<br/><br/>Providing detailed information will help us identify the root cause more efficiently and offer an effective solution.<br/><br/>⚠️ Without the “About Me” page photo, we cannot confirm your firmware version.<br/><br/>Here is an example of the “About Me” page:</p>"
          }
        },
        "image_HTtrfm": {
          "type": "image",
          "settings": {
            "img": "shopify://shop_images/about_me.png"
          }
        },
        "heading_Lnr8b6": {
          "type": "heading",
          "disabled": true,
          "settings": {
            "heading": "Firmware Update Guide"
          }
        },
        "rich_text_7MybfL": {
          "type": "rich_text",
          "disabled": true,
          "settings": {
            "rich_text": "<p><strong>Step 1:</strong>  Find The \"About Me\" Page</p><p>Long press the button on your product and hold for 3 seconds until \"About Me\" appears at the bottom of the screen, then release it to enter.</p><p><strong>Step 2:</strong> Identify Your Dockcase Details</p><p>Here is an example of the \"About Me\" page.</p>"
          }
        },
        "rich_text_4g3wxB": {
          "type": "rich_text",
          "disabled": true,
          "settings": {
            "rich_text": "<p>From this screen, note down the following three key details:</p><p>• Product/Firmware Model - \"DPR10P\"</p><p>• Hardware Version - \"H500\"</p><p>• Current Firmware Version - \"240118\"</p>"
          }
        },
        "rich_text_6hhgkb": {
          "type": "rich_text",
          "disabled": true,
          "settings": {
            "rich_text": "<p><strong>Step 3:</strong> Find the Correct Firmware</p><p>Firmware Lookup Tool link:</p><p><a href=\"https://jn07vnnw2f.feishu.cn/share/base/query/shrcn5eALxzIXVEfQGKcharpFJh\" target=\"_blank\" title=\"https://jn07vnnw2f.feishu.cn/share/base/query/shrcn5eALxzIXVEfQGKcharpFJh\"><em>https://jn07vnnw2f.feishu.cn/share/base/query/shrcn5eALxzIXVEfQGKcharpFJh</em></a></p><p>Please click the link and enter the information from your \"About Me\" page to find the correct firmware for your device.</p>"
          }
        },
        "image_CbKAYE": {
          "type": "image",
          "disabled": true,
          "settings": {
            "img": "shopify://shop_images/firmware_guide.png"
          }
        },
        "rich_text_KLDUCP": {
          "type": "rich_text",
          "disabled": true,
          "settings": {
            "rich_text": "<p><strong>Step 4:</strong> Download & Update Firmware</p><p>Once you've found the correct firmware for your device, download the firmware package. The firmware update instructions are included within the download package.</p>"
          }
        },
        "rich_text_7PCWRj": {

<style>
  .format-ssd-guide2-content {
    width: 100%;
    max-width: 1200px;
    margin: 0 auto;
  }
  .format-ssd-guide-part-title {
    margin: 40px 0;
    font-size: 22px;
    line-height: 26px;
    font-weight: 500;
  }
  .format-ssd-guide-richtext {
    margin: 40px 0;
    overflow-wrap: break-word;
  }
  .format-ssd-guide-richtext p {
    margin: 10px 0;
  }

  .format-ssd-guide-img {
    margin: 40px 0;
    display: flex;
    justify-content: center;
  }
</style>
<div {% render 'section-properties' %}>
  <div class="section-stack">
    <div class="format-ssd-guide2-content">
      {% for block in section.blocks %}
        {% case block.type %}
          {% when 'heading' %}
            <div class="format-ssd-guide-part-title">{{ block.settings.heading }}</div>
          {% when 'rich_text' %}
            <div class="format-ssd-guide-richtext">{{ block.settings.rich_text }}</div>
          {% when 'image' %}
            <div class="format-ssd-guide-img">
              <img src="{{ block.settings.img | image_url: width: master }}" alt="">
            </div>
          {% else %}

        {% endcase %}
      {% endfor %}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Format SSD Guide 2",
  "settings": [],
  "blocks": [
    {
      "type": "rich_text",
      "name": "Rich Text",
      "settings": [
        {
          "type": "richtext",
          "id": "rich_text",
          "label": "文案内容"
        }
      ]
    },
    {
      "type": "heading",
      "name": "Heading",
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "段落标题"
        }
      ]
    },
    {
      "type": "image",
      "name": "Image",
      "settings": [
        {
          "type": "image_picker",
          "id": "img",
          "label": "Image"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Format SSD Guide 2"
    }
  ]
}
{% endschema %}

{%- render 'section-spacing-collapsing' -%}
<style>
  .user-manual-title {
    font-size: var(--text-h2);
    line-height: 1.1;
    font-family: var(--heading-font-family);
    font-weight: var(--heading-font-weight);
    font-style: var(--heading-font-style);
    letter-spacing: var(--heading-letter-spacing);
    text-transform: var(--heading-text-transform);
    text-align: center;
  }
  .user-manual-download-box {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 20px;
    align-items: stretch;
    margin-top: 40px;
  }
  .manual-item {
    display: flex;
    flex-direction: column;
    height: 100%;
    background-color: #fbfbfb;
    color: #000;
    border-radius: 16px;
    overflow: hidden;
    cursor: pointer;
  }
  .manual-item-img {
    display: flex;
    justify-content: center;
    padding: 20px 0 0;
  }
  .manual-item-img img {
    transition: 0.3s ease;
    max-height: 240px;
  }
  .manual-item-info {
    text-align: center;
    padding: 20px 30px;
  }
  .manual-item-title {
    font-size: 16px;
    line-height: 20px;
  }
  .manual-item-sku {
    margin-top: 10px;
    font-size: 24px;
    line-height: 28px;
    font-weight: bold;
  }
  .manual-item:hover {
    box-shadow: 0 12px 20px 6px rgba(96, 109, 128, 0.04), 0 8px 16px 4px rgba(96, 109, 128, 0.04),
      0 4px 14px 0 rgba(98, 111, 131, 0.04);
  }
  .manual-item:hover .manual-item-sku {
    text-decoration: underline;
  }
  .manual-item:hover .manual-item-img img {
    transform: scale(1.05);
  }
  @media screen and (min-width: 768px) and (max-width: 1200px) {
    .user-manual-download-box {
      grid-template-columns: repeat(3, 1fr);
      gap: 15px;
    }
  }
  @media screen and (max-width: 767px) {
    .manual-item {
      border-radius: 8px;
    }
    .user-manual-download-box {
      margin-top: 25px;
      grid-template-columns: repeat(2, 1fr);
      gap: 10px;
    }
    .manual-item-info {
      padding: 15px;
    }
    .manual-item-title {
      font-size: 14px;
      line-height: 18px;
    }
    .manual-item-sku {
      margin-top: 5px;
      font-size: 18px;
      line-height: 22px;
    }
    .manual-item-img img {
      max-height: 150px;
    }
  }
</style>
<div {% render 'section-properties' %}>
  <div class="section-stack">
    <div class="user-manual-download-content">
      <h2 class="user-manual-title">{{ section.settings.header }}</h2>
      <div class="user-manual-download-box">
        {% for item in section.blocks %}
          <a href="{{ item.settings.manual_url }}" class="user-manual-item-box">
            <div class="manual-item">
              <div class="manual-item-img">
                <img src="{{ item.settings.manual_img | image_url: width: master }}" alt="">
              </div>
              <div class="manual-item-info">
                <p class="manual-item-title">{{ item.settings.manual_text }}</p>
                <p class="manual-item-sku">{{ item.settings.manual_text_sku }}</p>
              </div>
            </div>
          </a>
        {% endfor %}
      </div>
    </div>
  </div>
</div>
{% schema %}
{
  "name": "User Manual Download",
  "class": "shopify-section--user-manual-download",
  "tag": "section",
  "settings": [
    {
      "type": "text",
      "id": "header",
      "label": "标题",
      "default": "SSD Enclosure"
    },
    {
      "type": "header",
      "content": "以下为模板基础配置",
      "info": "以下配置为模板自带的snippets文件需要的配置项，为了保持模板风格的统一"
    },
    {
      "type": "checkbox",
      "id": "full_width",
      "label": "Full width",
      "default": true
    },
    {
      "type": "color",
      "id": "background",
      "label": "Background"
    },
    {
      "type": "color_background",
      "id": "background_gradient",
      "label": "Background gradient"
    }
  ],
  "blocks": [
    {
      "type": "manual",
      "name": "Manual",
      "settings": [
        {
          "type": "url",
          "id": "manual_url",
          "label": "说明书下载链接"
        },
        {
          "type": "image_picker",
          "id": "manual_img",
          "label": "说明书封面图"
        },
        {
          "type": "text",
          "id": "manual_text",
          "label": "说明书标题",
          "default": "2242 Enclosure"
        },
        {
          "type": "text",
          "id": "manual_text_sku",
          "label": "说明书对应SKU",
          "default": "DSWC1R-3B"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "User Manual Download",
      "category": "Download"
    }
  ]
}
{% endschema %}

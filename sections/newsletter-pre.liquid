{%- render 'section-spacing-collapsing' -%}

{%- liquid
  assign deposit_image_width = section.settings.deposit_image_width | default: 180
  assign deposit_image_width_mobile = section.settings.deposit_image_width_mobile | default: 135
-%}

<style>
  #shopify-section-{{ section.id }} {
    --newsletter-pre-deposit-image-width: {{ deposit_image_width }}px;
  }

  #shopify-section-{{ section.id }} .newsletter-pre {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    grid-template-rows: auto auto;
    column-gap: var(--spacing-10);
    row-gap: 0;
    align-items: stretch;
  }

  #shopify-section-{{ section.id }} .newsletter-pre__card,
  #shopify-section-{{ section.id }} .newsletter-pre__deposit-card {
    grid-row: span 2;
    display: grid;
    grid-template-rows: subgrid;
    gap: var(--spacing-8);
    background-color: {{ section.settings.card_background }};
    padding: var(--spacing-10);
    border-radius: var(--rounded);
    text-align: center;
  }

  #shopify-section-{{ section.id }} .newsletter-pre__card {
    justify-items: center;
  }

  #shopify-section-{{ section.id }} .newsletter-pre__deposit-card {
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: stretch;
    column-gap: var(--spacing-8);
  }

  #shopify-section-{{ section.id }} .newsletter-pre__header,
  #shopify-section-{{ section.id }} .newsletter-pre__actions {
    width: 100%;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  #shopify-section-{{ section.id }} .newsletter-pre__header {
    justify-content: center;
  }

  #shopify-section-{{ section.id }} .newsletter-pre__actions {
    height: 100%;
    justify-content: flex-start;
  }

  #shopify-section-{{ section.id }} .newsletter-pre__deposit-card > .newsletter-pre__header,
  #shopify-section-{{ section.id }} .newsletter-pre__deposit-card > .newsletter-pre__actions {
    grid-column: 1;
  }

  #shopify-section-{{ section.id }} .newsletter-pre__deposit-image {
    grid-column: 2;
    grid-row: 1 / -1;
    align-self: center;
    border-radius: var(--rounded);
    overflow: hidden;
    width: var(--newsletter-pre-deposit-image-width);
    max-width: var(--newsletter-pre-deposit-image-width);
  }

  #shopify-section-{{ section.id }} .newsletter-pre__deposit-image img {
    width: 100%;
    height: auto;
    display: block;
  }

  #shopify-section-{{ section.id }} .newsletter-pre__form {
    display: contents;
  }

  #shopify-section-{{ section.id }} .newsletter-pre__actions-inner {
    width: 100%;
    max-width: 420px;
    height: 100%;
    display: flex;
    flex-direction: column;
    align-items: stretch;
  }

  #shopify-section-{{ section.id }} .newsletter-pre__form-group {
    width: 100%;
    margin-top: auto;
    display: flex;
    flex-direction: column;
    align-items: stretch;
    gap: 12px;
  }

  #shopify-section-{{ section.id }} .newsletter-pre__field {
    width: 100%;
  }

  #shopify-section-{{ section.id }} .newsletter-pre__email {
    width: 100%;
    padding: 12px 24px;
    outline: none;
    border: 1px solid #000;
    border-radius: var(--rounded-button);
    font-size: 15px;
    line-height: 1.4;
    text-align: center;
    background: #fff;
    color: #000;
    box-sizing: border-box;
  }

  #shopify-section-{{ section.id }} .newsletter-pre__email::placeholder {
    color: #999;
  }

  #shopify-section-{{ section.id }} .newsletter-pre__email:focus {
    border-color: #000;
  }

  #shopify-section-{{ section.id }} .newsletter-pre__button-row {
    width: 100%;
  }

  #shopify-section-{{ section.id }} .newsletter-pre__deposit-card .newsletter-pre__button-row {
    margin-top: auto;
  }

  #shopify-section-{{ section.id }} .newsletter-pre__button-row .button {
    width: 100%;
  }

  #shopify-section-{{ section.id }} .newsletter-pre__sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  @media screen and (max-width: 767px) {
    #shopify-section-{{ section.id }} {
      --newsletter-pre-deposit-image-width: {{ deposit_image_width_mobile }}px;
    }

    #shopify-section-{{ section.id }} .newsletter-pre {
      grid-template-columns: minmax(0, 1fr);
      grid-template-rows: none;
      gap: var(--spacing-5);
    }

    #shopify-section-{{ section.id }} .newsletter-pre__card,
    #shopify-section-{{ section.id }} .newsletter-pre__deposit-card {
      grid-row: auto;
      display: grid;
      grid-template-rows: auto auto;
      padding: var(--spacing-8) var(--spacing-5);
      gap: var(--spacing-5);
    }

    #shopify-section-{{ section.id }} .newsletter-pre__deposit-card {
      grid-template-columns: minmax(0, 1fr) auto;
      column-gap: var(--spacing-5);
    }

    #shopify-section-{{ section.id }} .newsletter-pre__deposit-image {
      grid-column: 2;
      grid-row: 1 / -1;
      width: var(--newsletter-pre-deposit-image-width);
      max-width: var(--newsletter-pre-deposit-image-width);
    }

    #shopify-section-{{ section.id }} .newsletter-pre__email {
      font-size: 14px;
      padding: 10px 20px;
    }
  }
</style>

<div {% render 'section-properties' %}>
  <div class="section-stack">
    <div class="newsletter-pre">
      <div class="newsletter-pre__card">
        <div class="newsletter-pre__header">
          <div class="v-stack gap-2">
            {%- if section.settings.heading != blank -%}
              <h2 class="h3">{{ section.settings.heading | escape }}</h2>
            {%- endif -%}

            {%- if section.settings.subheading != blank -%}
              <p class="text-subdued">{{ section.settings.subheading | escape }}</p>
            {%- endif -%}
          </div>
        </div>

        {%- assign newsletter_form_id = 'newsletter-pre-form-' | append: section.id -%}
        {%- if section.settings.email_label != blank -%}
          {%- assign email_label = section.settings.email_label -%}
        {%- else -%}
          {%- assign email_label = 'general.newsletter.email' | t -%}
        {%- endif -%}
        {%- form 'customer', id: newsletter_form_id, class: 'form newsletter-pre__form' -%}
          <div class="newsletter-pre__actions">
            <div class="newsletter-pre__actions-inner">
              {%- if form.posted_successfully? -%}
                {%- assign success_message = 'general.newsletter.subscribed_successfully' | t -%}
                {%- render 'banner', content: success_message, status: 'success' -%}
              {%- else -%}
                <div class="newsletter-pre__form-group">
                  {%- if form.errors -%}
                    {%- capture error_message -%}{{ form.errors.translated_fields.email }} {{ form.errors.messages.email }}{%- endcapture -%}
                    {%- render 'banner', content: error_message, status: 'error' -%}
                  {%- endif -%}

                  <input type="hidden" name="contact[tags]" value="newsletter">

                  <div class="newsletter-pre__field">
                    <label class="newsletter-pre__sr-only" for="NewsletterPreEmail-{{ section.id }}">
                      {{- email_label | escape -}}
                    </label>
                    <input
                      id="NewsletterPreEmail-{{ section.id }}"
                      class="newsletter-pre__email"
                      type="email"
                      name="contact[email]"
                      autocorrect="off"
                      autocapitalize="off"
                      autocomplete="email"
                      enterkeyhint="send"
                      placeholder="{{ email_label | escape }}"
                      required
                      {% if form.errors %}
                        aria-invalid="true"
                      {% endif %}
                    >
                  </div>

                  <div class="newsletter-pre__button-row">
                    {%- render 'button',
                      type: 'submit',
                      content: section.settings.subscribe_btn_text,
                      size: 'xl',
                      stretch: true,
                      background: section.settings.button_background,
                      text_color: section.settings.button_text_color
                    -%}
                  </div>
                </div>
              {%- endif -%}
            </div>
          </div>
        {%- endform -%}
      </div>

      <div class="newsletter-pre__deposit-card">
        <div class="newsletter-pre__header">
          <div class="v-stack gap-2">
            {%- if section.settings.buy_text != blank -%}
              <h2 class="h3">{{ section.settings.buy_text | escape }}</h2>
            {%- endif -%}

            {%- if section.settings.buy_info != blank -%}
              <p class="text-subdued">{{ section.settings.buy_info | escape }}</p>
            {%- endif -%}
          </div>
        </div>

        <div class="newsletter-pre__actions">
          <div class="newsletter-pre__actions-inner">
            <div class="newsletter-pre__button-row">
              {%- if section.settings.buy_product != blank -%}
                {%- assign deposit_product = section.settings.buy_product -%}
                {%- assign deposit_variant = deposit_product.selected_or_first_available_variant -%}

                {%- if deposit_variant != blank -%}
                  {%- capture checkout_url -%}{{ routes.cart_url }}/{{ deposit_variant.id }}:1?checkout{%- endcapture -%}
                  {%- render 'button',
                    href: checkout_url,
                    content: section.settings.buy_btn_text,
                    size: 'xl',
                    stretch: true,
                    background: section.settings.deposit_button_background,
                    text_color: section.settings.deposit_button_text_color
                  -%}
                {%- else -%}
                  {%- render 'button',
                    content: section.settings.buy_btn_text,
                    size: 'xl',
                    stretch: true,
                    disabled: true
                  -%}
                {%- endif -%}
              {%- endif -%}
            </div>
          </div>
        </div>

        {%- if section.settings.buy_img != blank -%}
          {%- assign deposit_image_srcset_width = deposit_image_width | at_least: deposit_image_width_mobile | times: 2 -%}
          {%- capture deposit_image_sizes -%}(max-width: 767px) {{ deposit_image_width_mobile }}px, {{ deposit_image_width }}px{%- endcapture -%}
          <div class="newsletter-pre__deposit-image">
            {{-
              section.settings.buy_img
              | image_url: width: deposit_image_srcset_width
              | image_tag:
                loading: 'lazy',
                widths: '135, 180, 270, 360, 540, 720',
                sizes: deposit_image_sizes,
                alt: section.settings.buy_text
            -}}
          </div>
        {%- endif -%}
      </div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Newsletter Pre-order",
  "class": "shopify-section--newsletter-pre",
  "tag": "section",
  "disabled_on": {
    "templates": ["password"],
    "groups": ["header", "custom.overlay"]
  },
  "settings": [
    {
      "type": "header",
      "content": "邮件订阅"
    },
    {
      "type": "paragraph",
      "content": "订阅用户的邮箱将加入「接受营销」客户列表。"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "订阅标题",
      "default": "Get An Exclusive Discount!"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "订阅文案"
    },
    {
      "type": "text",
      "id": "email_label",
      "label": "邮箱输入框标签",
      "default": "Enter your email address"
    },
    {
      "type": "text",
      "id": "subscribe_btn_text",
      "label": "订阅按钮文案",
      "default": "Reserve launch invite"
    },
    {
      "type": "header",
      "content": "定金支付"
    },
    {
      "type": "text",
      "id": "buy_text",
      "label": "定金标题",
      "default": "Pay $1 now."
    },
    {
      "type": "textarea",
      "id": "buy_info",
      "label": "定金文案"
    },
    {
      "type": "product",
      "id": "buy_product",
      "label": "定金产品"
    },
    {
      "type": "text",
      "id": "buy_btn_text",
      "label": "支付按钮文案",
      "default": "Pay Now"
    },
    {
      "type": "image_picker",
      "id": "buy_img",
      "label": "右侧图片"
    },
    {
      "type": "range",
      "id": "deposit_image_width",
      "label": "定金图片宽度（PC）",
      "min": 80,
      "max": 400,
      "step": 5,
      "unit": "px",
      "default": 180
    },
    {
      "type": "range",
      "id": "deposit_image_width_mobile",
      "label": "定金图片宽度（移动端）",
      "min": 60,
      "max": 400,
      "step": 5,
      "unit": "px",
      "default": 135
    },
    {
      "type": "header",
      "content": "样式"
    },
    {
      "type": "color",
      "id": "card_background",
      "label": "卡片背景色",
      "default": "#f3f3f3"
    },
    {
      "type": "header",
      "content": "以下为模板基础配置"
    },
    {
      "type": "checkbox",
      "id": "full_width",
      "label": "Full width",
      "default": true
    },
    {
      "type": "color",
      "id": "background",
      "label": "Background"
    },
    {
      "type": "color_background",
      "id": "background_gradient",
      "label": "Background gradient"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text"
    },
    {
      "type": "color",
      "id": "button_background",
      "label": "订阅按钮背景色"
    },
    {
      "type": "color",
      "id": "button_text_color",
      "label": "订阅按钮文字色"
    },
    {
      "type": "color",
      "id": "deposit_button_background",
      "label": "支付按钮背景色"
    },
    {
      "type": "color",
      "id": "deposit_button_text_color",
      "label": "支付按钮文字色"
    }
  ],
  "presets": [
    {
      "name": "Newsletter Pre-order",
      "category": "Call to action"
    }
  ]
}
{% endschema %}

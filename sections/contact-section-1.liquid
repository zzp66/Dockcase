{%- render 'section-spacing-collapsing' -%}
<style>
  .contact-section1 {
    margin: 40px 0 0;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 60px;
    justify-content: flex-start;
    align-items: stretch;
  }
  .topic-img {
    display: flex;
  }
  .topic-img img {
    max-width: 80px;
  }
  p.topic-title {
    color: #fff;
    margin: 20px 0;
    font-size: 28px;
    font-weight: bold;
    line-height: 32px;
  }
  p.topic-text {
    color: #fff;
    margin: 0 0 20px;
    font-size: 16px;
    font-weight: 400;
    line-height: 20px;
  }
  a.topic-link {
    color: #fff;
    margin: 20px 0 0;
    font-size: 16px;
    font-weight: 400;
    line-height: 20px;
    text-decoration: underline;
    text-underline-offset: 5px;
  }
  @media screen and (max-width: 767px) {
    .contact-section1 {
      grid-template-columns: 1fr;
      gap: 20px;
      margin: 25px 0 0;
    }
    .topic-img img {
      max-width: 55px;
    }
    p.topic-title {
      margin: 15px 0;
      font-size: 18px;
      line-height: 22px;
    }
    p.topic-text {
      margin: 0 0 15px;
      font-size: 14px;
      line-height: 24px;
    }
    a.topic-link {
      margin: 15px 0 0;
      font-size: 14px;
      line-height: 18px;
    }
  }
</style>
<div {% render 'section-properties' %}>
  <div class="section-stack">
    <div class="contact-section1-content">
      {%- if section.settings.title != blank -%}
        <h2 class="h2">
          {%- render 'styled-text',
            content: section.settings.title,
            text_color: section.settings.heading_color,
            gradient: section.settings.heading_gradient
          -%}
        </h2>
      {%- endif -%}
      <div class="contact-section1">
        {% for block in section.blocks %}
          <div class="common-topic-item">
            <div class="topic-img">
              <img src="{{ block.settings.topic_img | image_url: width: master }}" alt="">
            </div>
            <p class="topic-title">{{ block.settings.topic_title }}</p>
            <p class="topic-text">{{ block.settings.topic_text }}</p>
            <a href="{{ block.settings.topic_url }}" class="topic-link">{{ block.settings.topic_btn }}</a>
          </div>
        {% endfor %}
      </div>
    </div>
  </div>
</div>
{% schema %}
{
  "name": "Contact Section 1",
  "class": "shopify-section--contact-section1",
  "tag": "section",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "Common Topics"
    },
    {
      "type": "header",
      "content": "以下为模板基础配置"
    },
    {
      "type": "checkbox",
      "id": "full_width",
      "label": "Full width",
      "default": true
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading color"
    },
    {
      "type": "color_background",
      "id": "heading_gradient",
      "label": "Heading gradient"
    },
    {
      "type": "color",
      "id": "background",
      "label": "Background"
    },
    {
      "type": "color_background",
      "id": "background_gradient",
      "label": "Background gradient"
    }
  ],
  "blocks": [
    {
      "type": "topic",
      "name": "Topic",
      "settings": [
        {
          "type": "image_picker",
          "id": "topic_img",
          "label": "Icon图标"
        },
        {
          "type": "text",
          "id": "topic_title",
          "label": "Topic标题",
          "default": "General FAQs"
        },
        {
          "type": "text",
          "id": "topic_text",
          "label": "文案",
          "default": "Frequenyly asked questions about logistics, payments"
        },
        {
          "type": "url",
          "id": "topic_url",
          "label": "跳转链接"
        },
        {
          "type": "text",
          "id": "topic_btn",
          "label": "按钮文案",
          "default": "Learn More"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Contact Section 1",
      "category": "Content"
    }
  ]
}
{% endschema %}
